FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish UdpHosts/GameServer/GameServer.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/runtime:8.0
WORKDIR /app
COPY --from=build /app .
# clientdb.sd2 must be bind-mounted; override via GAMESERVER_STATICDBPATH
ENV GAMESERVER_STATICDBPATH=/data/clientdb.sd2
EXPOSE 25001/udp
ENTRYPOINT ["dotnet", "GameServer.dll"]
